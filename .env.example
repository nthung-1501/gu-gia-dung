# DATABASE — Supabase
DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres

# REDIS — Upstash (use rediss:// with double s for TLS)
REDIS_URL=rediss://default:PASSWORD@XXXX.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://XXXX.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# AI — Claude API
ANTHROPIC_API_KEY=sk-ant-...

# VIDEO — TopView
TOPVIEW_API_KEY=

# VIDEO RENDER — Creatomate
CREATOMATE_API_KEY=
# Template IDs per series (get from Creatomate dashboard → Templates)
CREATOMATE_TEMPLATE_TEST_THAT=3aed0fa9-264f-4020-ac9c-d6e0f87328da
CREATOMATE_TEMPLATE_HOUSE_30S=4117e09a-5ec8-4e5d-afa6-63f0e008a977
CREATOMATE_TEMPLATE_WHICH_ONE=09abf3d9-f1de-482f-bb2c-e7c22e0fd38c

# TIKTOK
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=
NODE_ENV=development
